{
  "name": "customer-360-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/server.ts",
    "typecheck": "tsc --noEmit",
    "build:server": "tsdown",
    "build:client": "vite build --config client/vite.config.ts",
    "stage": "bash scripts/stage-deploy.sh",
    "build": "npm run typecheck && npm run build:server && npm run build:client && npm run stage",
    "start": "node build/server.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@databricks/appkit": "^0.1.2",
    "@databricks/appkit-ui": "^0.1.2",
    "@deck.gl/aggregation-layers": "^9.3.2",
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/extensions": "^9.3.2",
    "@deck.gl/geo-layers": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/mapbox": "^9.3.2",
    "@xyflow/react": "^12.11.1",
    "h3-js": "^4.4.0",
    "lucide-react": "^1.22.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-map-gl": "^8.1.1",
    "react-markdown": "^9.0.1",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.0",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "tsdown": "^0.12.5",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vite": "^6.3.5"
  }
}
